<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="VideoHelper.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Video Helper">

    <Grid x:Name="RootGrid" Background="#0A0F1E" RequestedTheme="Dark">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Custom title bar -->
        <Grid x:Name="TitleBarDragRegion" Grid.Row="0" Padding="16,0,140,0" Background="#D90A0F1E">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Image Source="Assets/VideoHelper-icon.png" Width="25" Height="25" />
                <TextBlock Text="Video Helper" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <!-- Hero -->
        <Border Grid.Row="1" Margin="24,14,24,0" Padding="26,24" CornerRadius="20">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#1D4ED8" Offset="0" />
                    <GradientStop Color="#4338CA" Offset="0.52" />
                    <GradientStop Color="#7C3AED" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
            <Grid>
                <StackPanel VerticalAlignment="Center" Spacing="7">
                    <TextBlock Text="Соберите видео воедино" FontSize="27" FontWeight="SemiBold" />
                    <TextBlock
                        MaxWidth="590"
                        Text="Объединяйте части MP4 за несколько секунд — без перекодирования и без потери исходного качества."
                        TextWrapping="Wrap"
                        Foreground="#D9FFFFFF"
                        FontSize="14" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Toolbar -->
        <Grid Grid.Row="2" Margin="24,18,24,12" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button
                Padding="16,9"
                Background="#2563EB"
                BorderThickness="0"
                CornerRadius="9"
                Click="AddFiles_Click">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE8E5;" FontSize="15" />
                    <TextBlock Text="Добавить части" />
                </StackPanel>
            </Button>
            <Button Grid.Column="1" Padding="13,9" Background="#171E32" BorderBrush="#2A3554" CornerRadius="9" Click="RemoveSelected_Click">
                <StackPanel Orientation="Horizontal" Spacing="7">
                    <FontIcon Glyph="&#xE74D;" FontSize="14" />
                    <TextBlock Text="Убрать из списка" />
                </StackPanel>
            </Button>
            <Button Grid.Column="2" Padding="13,9" Background="#171E32" BorderBrush="#2A3554" CornerRadius="9" Click="Clear_Click">
                <TextBlock Text="Очистить" />
            </Button>
            <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="9" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Border Padding="10,5" Background="#151C2F" CornerRadius="8">
                    <TextBlock x:Name="FileCountText" Text="0 частей" Foreground="#AFC2E9" FontSize="12" />
                </Border>
                <Border Padding="10,5" Background="#151C2F" CornerRadius="8">
                    <TextBlock x:Name="TotalSizeText" Text="0 МБ" Foreground="#AFC2E9" FontSize="12" />
                </Border>
            </StackPanel>
        </Grid>

        <!-- File area -->
        <Border
            Grid.Row="3"
            Margin="24,0"
            Background="#11182A"
            BorderBrush="#2B3655"
            BorderThickness="1"
            CornerRadius="16"
            AllowDrop="True"
            DragOver="DropArea_DragOver"
            Drop="DropArea_Drop">
            <Grid>
                <ListView
                    x:Name="PartsList"
                    Margin="8"
                    Background="Transparent"
                    SelectionMode="Multiple">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="2,3" Padding="13,11" Background="#171F34" CornerRadius="11">
                                <Grid ColumnSpacing="13">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="38" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="36" Height="36" Background="#263B82F6" CornerRadius="9">
                                        <TextBlock Text="{Binding Number}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#8DB9FF" FontWeight="SemiBold" />
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                                        <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Folder}" FontSize="11" Foreground="#7F91B5" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <Border Grid.Column="2" Padding="9,5" Background="#0D1425" CornerRadius="7" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding SizeText}" Foreground="#9FB0D0" FontSize="12" />
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
                    <Border Width="72" Height="72" Background="#1D2C52" CornerRadius="20">
                        <FontIcon Glyph="&#xE8B7;" FontSize="30" Foreground="#79A9FF" />
                    </Border>
                    <TextBlock Text="Перетащите сюда части MP4" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center" />
                    <TextBlock Text="или нажмите «Добавить части»" FontSize="13" Foreground="#7F91B5" HorizontalAlignment="Center" />
                    <TextBlock Text="Файлы автоматически выстроятся по номерам" FontSize="11" Foreground="#52617F" HorizontalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="4" Margin="24,12,24,0" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <InfoBar x:Name="StatusBar" IsOpen="False" IsClosable="True" />
            <Button
                x:Name="ShowInFolderButton"
                Grid.Column="1"
                Padding="14,9"
                Background="#171E32"
                BorderBrush="#2A3554"
                CornerRadius="9"
                Click="ShowInFolder_Click"
                Visibility="Collapsed">
                <StackPanel Orientation="Horizontal" Spacing="7">
                    <FontIcon Glyph="&#xE838;" FontSize="14" />
                    <TextBlock Text="Показать в папке" />
                </StackPanel>
            </Button>
        </Grid>

        <!-- Footer -->
        <Grid Grid.Row="5" Margin="24,16,24,22" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center" Spacing="5">
                <StackPanel Orientation="Horizontal" Spacing="7">
                    <FontIcon Glyph="&#xE73E;" FontSize="12" Foreground="#34D399" />
                    <TextBlock Text="Без потери качества" FontSize="12" Foreground="#9FB0D0" />
                </StackPanel>
                <TextBlock Text="© 2026 KingPrivet. All rights reserved." FontSize="11" Foreground="#7F91B5" />
                <ProgressBar x:Name="JoinProgress" Width="290" Height="3" IsIndeterminate="True" Visibility="Collapsed" HorizontalAlignment="Left" />
            </StackPanel>
            <Button
                x:Name="JoinButton"
                Grid.Column="1"
                Padding="22,11"
                Background="#7C3AED"
                BorderThickness="0"
                CornerRadius="10"
                Click="Join_Click"
                IsEnabled="False">
                <StackPanel Orientation="Horizontal" Spacing="9">
                    <FontIcon Glyph="&#xE768;" FontSize="15" />
                    <TextBlock Text="Склеить видео" FontWeight="SemiBold" />
                </StackPanel>
            </Button>
        </Grid>
    </Grid>
</Window>
